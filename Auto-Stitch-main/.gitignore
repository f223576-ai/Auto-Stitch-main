# Environment and Secrets (CRITICAL: Do NOT commit secrets)
.env
.env.*
*.env
backend/.env
frontend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example configuration templates
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production Build Outputs
dist/
build/
frontend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE & Editor Directories
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Temporary / Scratch files
scratch/
extracted_srs.txt
srs_content.txt
MASTER PROMPT*

# Runtime uploads
backend/uploads/*
!backend/uploads/.gitkeep
uploads/vto_temp/

# Virtual try-on checkpoints
IDM-VTON/ckpt/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Test and typecheck output
coverage/
.nyc_output/
*.tsbuildinfo

